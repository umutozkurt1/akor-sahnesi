          "col": 26
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sonsuzluksa beklediğimiz, zamana senle dayanırım",
      "chords": [
        {
          "chord": "F",
          "col": 0
        },
        {
          "chord": "G",
          "col": 25
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yorgun ruhum birikmiş yaşlarla, kan revan içinde yığılsam",
      "chords": [
