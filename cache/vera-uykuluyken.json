      "chords": [
        {
          "chord": "G",
          "col": 15
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gözlerimde bir yol varsa, bitmiyor tükenmiyorsa,",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        },
        {
          "chord": "Dm",
          "col": 21
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bizse; bekleyen yolcular, hiçe çıkan sokaklarda.",
      "chords": [
        {
          "chord": "F",
          "col": 0
        },
        {
          "chord": "G",
          "col": 22
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Eğer bi cennet varsa en uçta, yüzümü her kapattığımda,",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        },
        {
          "chord": "Dm",
          "col": 25
        }
      ],
      "section": false,
      "t": null
