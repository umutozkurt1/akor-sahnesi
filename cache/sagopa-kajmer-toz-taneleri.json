      "section": false,
      "t": null
    },
    {
      "lyric": "Hüznümün en yükseğinden şöyle baksan",
      "chords": [
        {
          "chord": "E",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Manzarama gözlerini alamazdın, gözlerini alırdılar.",
      "chords": [
        {
          "chord": "E",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Mazi bazen mavi,bazen haki, bazen zifir",
      "chords": [
        {
          "chord": "D#m",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ve mazidekiler bazen şeker bazen zehir.",
      "chords": [
        {
          "chord": "D#m",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Karanlığa yanaşır aydınlık",
      "chords": [
        {
          "chord": "E",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Limana yanaştığı gibi geminin, güzellik arayışın da çirkin.",
      "chords": [
        {
          "chord": "E",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "İçinde çok kişi var terketmediğin.",
      "chords": [
        {
          "chord": "D#m",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yapamasan da olsaydı en azından sarfetmişliğin.",
      "chords": [
        {
          "chord": "D#m",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kaç kendinden,yarış mesafelerle.",
      "chords": [
        {
          "chord": "E",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ya da korkma seni kurtar savaş süvarilerle.",
      "chords": [
        {
          "chord": "E",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bak ben kopardım güneşten parçalar ellerimle,",
      "chords": [
        {
          "chord": "D#m",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Fırlattım onun kardan adamlarına var gücümle.",
      "chords": [
        {
          "chord": "D#m",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Eksik kalan şiirlerini topluyorum bugünlerde",
      "chords": [
        {
          "chord": "E",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ömrümün ve çıplak ayaklarımın izleri asfaltta.",
      "chords": [
        {
          "chord": "E",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "İki kişilikken teke düştüm hayatta",
      "chords": [
        {
          "chord": "D#m",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ama duble söyledim rakımı masama inatla.",
      "chords": [
        {
          "chord": "D#m",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "NAKARAT",
      "chords": [],
      "section": true,
      "t": null
    },
    {
      "lyric": "Uçur beni rüzgar toz taneleri gibi",
      "chords": [
        {
          "chord": "E",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Burdan uzağa doğru.",
      "chords": [
        {
          "chord": "D#m",
          "col": 13
        }
      ],
      "section": false,
      "t": null
    },
    {
