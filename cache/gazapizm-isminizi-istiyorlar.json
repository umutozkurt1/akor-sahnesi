  "lines": [
    {
      "lyric": "Benden isminizi istiyorlar onlar",
      "chords": [
        {
          "chord": "B",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Tutmuşlar iki yakamdan, diyorum Olmaz!",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Süre gelen erozyonun en pahalı kaybıyken arkadaşlık",
      "chords": [
        {
          "chord": "C",
          "col": 21
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ben bu sınavdan kalmam",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Biz ne kadar değişmişiz öyle ayan beyan diklenirken hayata",
      "chords": [
        {
          "chord": "B",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sonra baktık baya baya yenilmişiz onlara",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bu kasvete dayanmayan eğilmiş o boyunlar",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Üstümüzde oyunlar",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Anlat kollarında yaralarla sen utanma",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Güzel şeyler büyük acılarla gelir aldanma",
      "chords": [
        {
          "chord": "C",
          "col": 24
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ayrıntıya takık azınlığa hayran insanların",
      "chords": [
        {
          "chord": "B",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gün gelince böyle ağzı bıçak açmaz",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Şu sokakta toplan'ca'z",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sen Sevda diyorsun, Aşk diyorsun da şimdi olmaz",
      "chords": [
        {
          "chord": "A",
          "col": 33
        }
      ],
      "section": false,
      "t": null
    },
    {
