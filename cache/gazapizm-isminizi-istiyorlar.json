        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sonra Bur'dan öyle kalkıp, çekip git! diyorlar",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Önümde dosyalar yalan yanlış tutanaklar",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sen yanarsın bak! diyorlar, hiçbir şeyi bilmiyorlar",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bahar gibi dostum, bahar gibi olsun",
      "chords": [
        {
          "chord": "B",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ne var bizim aklımızda? Neden koşup durduk?",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ne ol'caksa olsun artık azdan azı düştük",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "İsyan etmenin bi' faydası yok, konuşmuştuk bunu",
      "chords": [
        {
          "chord": "A",
          "col": 39
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Onlar güzel insanlar",
      "chords": [
        {
          "chord": "B",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yok yalanım hayır diyenlerin boş kafası",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Temiz yarınlara yol yakanın zaten bir gün kol kanadı kop'cak",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Son sözümüz elbette ki Hoşça kalın olmaz",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ne vermiş de sanki, ne istiyor benden onlar?",
      "chords": [
        {
          "chord": "B",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
