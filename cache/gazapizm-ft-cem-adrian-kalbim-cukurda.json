        {
          "chord": "B",
          "col": 16
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "O kalbi gerekirse parçalar elim",
      "chords": [
        {
          "chord": "Dbm",
          "col": 17
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Asla kaçmadan geri, onlar bulmadan beni",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Koş gel bir köşebaşında kesilmiş nefesim",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kısılmış sesim, sanki çok yakınmış deniz",
      "chords": [
        {
          "chord": "Gbm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gözümde sanrılar gerçeğin tılsımı etik",
      "chords": [
        {
          "chord": "A",
          "col": 8
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Mahallem fişlenmiş, basılmış evim",
      "chords": [
        {
          "chord": "B",
          "col": 9
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sakınmış beni, belki bir ağaç, belki bir kedi",
      "chords": [
        {
          "chord": "Dbm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Vefa servetim dedim, sevda ailedir denir",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Cebimde çakım var, kalbimde hasretin kiri",
      "chords": [
        {
          "chord": "Gbm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bilirsin ansızın kapanan kapılar açılmaz geri",
      "chords": [
        {
          "chord": "A",
          "col": 17
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ve dünya gözünde her kıta silik",
      "chords": [
        {
          "chord": "B",
          "col": 29
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Dört yanım ihanet, dört yanım yılan",
      "chords": [
        {
          "chord": "Dbm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Geçmemiş bu kış, gelmemiş bahar",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Çukurda binaları üstüme yıkan",
      "chords": [
        {
          "chord": "Gbm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gülümser önümde yüzlerce zaaf",
      "chords": [
        {
          "chord": "A",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Umut herşeyden muaf",
      "chords": [
        {
          "chord": "B",
          "col": 18
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Dönmedim geri, çıkmıyor üstümden geçmişin kiri",
      "chords": [
        {
          "chord": "Dbm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gözüm kör zihnim hep tetiktedir",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bugün olmuyor istediklerim",
      "chords": [
        {
          "chord": "Gbm",
          "col": 14
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yanımbaşımda hep filizlenir bu umulmaz kağır",
      "chords": [],
      "section": false,
      "t": null
