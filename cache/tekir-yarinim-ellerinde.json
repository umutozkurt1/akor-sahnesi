        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yarınım ellerinde !",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Arafı del benimle, sel gibi dağıt !",
