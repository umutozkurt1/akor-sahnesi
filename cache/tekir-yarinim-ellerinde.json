        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kahırım olma, gül hep...",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "İzini ver, bi’ lütfet...",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bi’ kere ben de gülsem ?..",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Çaresiz vebayım, söyle; dert misin deva mı ?",
      "chords": [
