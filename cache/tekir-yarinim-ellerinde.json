          "col": 18
        },
        {
          "chord": "F#m",
          "col": 61
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ellere hep ellerinle ittiğini,",
      "chords": [
        {
          "chord": "Bm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ve bugün ayaklarınla teptiğini; yarın avuçlarınla bir dilersinki...",
      "chords": [
        {
          "chord": "F#m",
          "col": 50
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Şaşar kalır yanarsın, ah !",
      "chords": [
        {
          "chord": "G",
          "col": 36
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Unutma; bir bedeli var ! Her ah’ın bir sebebi var...",
      "chords": [
        {
          "chord": "F#m",
          "col": 77
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "İki uçlu bir muamma; hayatın her köşesi bilmece, çözemedim hiç...",
      "chords": [
        {
          "chord": "Bm",
          "col": 110
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sustum.. Ben de öyle kendi bildiğimce sustum.",
      "chords": [
        {
          "chord": "Bm",
          "col": 0
        },
        {
          "chord": "G",
          "col": 64
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Zaten herkes kendi benliğiyle suspus..",
      "chords": [
        {
          "chord": "F#m",
          "col": 58
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Lanet evren, lanet heryerin !",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "İkametim sefalet, davetin hıyanet !",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yolculuk soluksuz...",
      "chords": [
        {
          "chord": "Bm",
          "col": 20
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Denedik hep, durmadık, sonuç; olumsuz !",
      "chords": [
        {
          "chord": "G",
          "col": 60
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Aynı son hep; her gidiş biraz onursuz...",
      "chords": [
        {
          "chord": "F#m",
          "col": 53
        }
      ],
      "section": false,
      "t": null
    },
    {
