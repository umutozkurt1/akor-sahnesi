        {
          "chord": "C#m",
          "col": 4
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gittin verdin düşmana açıklarımızı",
      "chords": [
        {
          "chord": "F#m",
          "col": 56
        }
      ],
      "section": false,
      "t": null
    },
    {
