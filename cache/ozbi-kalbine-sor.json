      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Aşk; ruhunun iradesi",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Başkasının değil kendin ol diyenin annesi",
      "chords": [
        {
          "chord": "E",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ve aşk; bir rüyanın adresi",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Amma adalet kokan gerçeğin terazisi",
      "chords": [
        {
          "chord": "E",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Aşk; kalbimin tek eğrisi",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Irkçılığın sahte kavgalarını neylesin",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yüzleş, en büyük felaket savaş",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yaşandı tarih, kitap değil yavaş lan",
      "chords": [
        {
          "chord": "E",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ciğeri beş para etmez egolarıyla hükmedenlerin hükümlerine",
      "chords": [
        {
          "chord": "C",
          "col": 0
        },
        {
          "chord": "E",
          "col": 60
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "sokayım",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Titreyip kamaş sen, kendin ol, çocukluğunun yasını tut",
      "chords": [
        {
          "chord": "E",
          "col": 0
        },
        {
          "chord": "C",
          "col": 36
        }
      ],
      "section": false,
      "t": null
