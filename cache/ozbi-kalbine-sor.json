          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kimliğin hiçe sayıldı, sahipsiz gömüldün",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ben buyum dedin, evin yakıldı",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sonra dövüldün, bir ağıt yankılandı",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ve ruhun aşka bölündü, iki büklüm oldun",
      "chords": [
        {
          "chord": "C",
          "col": 46
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Canın yüklü doğdu, ve hiç anlamamış seni komşunun sümüklü",
      "chords": [
        {
          "chord": "E",
          "col": 37
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "oğlu",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Lakin onunla büyüdün, hep nasılsın diye sordun",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sonra sen en büyük oldun oysa hükümlü oldu",
      "chords": [
        {
          "chord": "E",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Senin büyük olman, en en büyük olman",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Neyi değiştirir lan ölüm varken büyük olmak",
      "chords": [
        {
          "chord": "E",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hassiktir oradan, havalı pozlar atma bana",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Otuz yıldır yaşıyorum seni, yeter yalanla yakınman",
      "chords": [
        {
          "chord": "E",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Oyuna geldin, erdemin nedir?",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Seni eğip büktüler, söyle gerçeğin nedir?",
      "chords": [
        {
          "chord": "E",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sanırım insanlık sana göre ruhların demi",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "O zaman hangi tanrı üstünlük bunların dedi ha?",
      "chords": [
        {
          "chord": "E",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Düşündün mü? Tabi ki hiç düşünmedin",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Çünkü hiçbir asır yoksunluğun bu kadar övülmedi",
      "chords": [
        {
          "chord": "E",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yoksunluk; bir terk ediş gibi",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Çocukluğunda aşk giyen tüm özlemlerimi",
      "chords": [
        {
          "chord": "E",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yine övüldün yanında olanların dilleriyle",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Senin yerine geçmek isteyen düşkünlerin eliyle",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gücün sevdası bu, alay eder kimiyle",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kimle rüzgarları yollar, petrolün yeliyle",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Unutma, hep haklı olmak istedin",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Haksız olmak ezilmekti",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Dedin ki ezilmek mi? Dedin ki yenilmektir",
      "chords": [
        {
          "chord": "C",
          "col": 44
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yenilmem asla dedin ve silahı çektin",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kimdi keklik, hiç bilmedin, hiç görmedin ve hiç sevmedin",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        },
        {
          "chord": "C",
          "col": 67
        }
      ],
      "section": false,
      "t": null
    },
    {
