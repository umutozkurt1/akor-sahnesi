          "col": 0
        },
        {
          "chord": "E",
          "col": 34
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Nefret bir illet gibi besleniyor kandan",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Aşkı anlayan vazgeçer mi bahardan (ha?)",
      "chords": [
        {
          "chord": "E",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Aşk; bi' şiir cümlesi, dokunduğunda içine işleyen bir sevgi",
      "chords": [
        {
          "chord": "C",
          "col": 0
        },
        {
