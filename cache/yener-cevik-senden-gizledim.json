    {
      "lyric": "Bu benim yazdığım ilk günlük, saniye bazen bi' sene, ay ve gündü",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "İnsanı insan affedince hürdür, gözlerinde sürme saçlarınla güldü",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Çıkamayacağın sözlere yemin etme, özlüyo'n o biçim sevince olmaz bitme",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ağlamak da güzeldir, göz yaşı silme, ben benden biliyorum sen bilmezsen bilme",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Şu an deseydin keşke Günaydın., gerçeği hayal de çok güzel duraydı",
      "chords": [],
      "section": false,
      "t": null
    },
    {
