        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Neden olmasın bu taş?",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kalbin çatlasın ve ortadan ikiye yarılsın.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ahhhh ayrılığa sebebimiz olmasın,",
      "chords": [
        {
          "chord": "Bb",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "İçinde hep bu cümle çınlasın.",
      "chords": [
        {
          "chord": "A",
          "col": 11
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Akıttığım gözyaşları gökyüzünde dağılsın ve şemsiyeni yoklasın.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yar yarın olmasın, günlerin çuvala girip deyimlerde yaşasın.",
      "chords": [
        {
          "chord": "Dm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yaar artık buradasın, nereye baksam oradasın… desem de inanmazsın,",
      "chords": [
        {
          "chord": "Gm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Haklısın.",
      "chords": [
        {
          "chord": "Bb",
          "col": 9
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ben bir kurnazım, tuzaklarla kuruluyum ama",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bu en iyi niyetli kumpasım.",
      "chords": [
        {
          "chord": "Dm",
          "col": 28
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yarın olmasın.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bunca şeye rağmen neden olmasın?",
      "chords": [
        {
          "chord": "A",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Aşk, seni bir kere görmedim iyi niyetinle şu kapıma dayan.",
      "chords": [
        {
          "chord": "Dm",
          "col": 0
        },
        {
          "chord": "Gm",
          "col": 91
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Beni bir kere görmedin ama kafamın içindeki isyan…",
      "chords": [
        {
          "chord": "Bb",
          "col": 83
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Olan oldu ama niye olur gibi oldu bu anlamadım.",
      "chords": [
        {
          "chord": "A",
          "col": 79
        }
      ],
      "section": false,
      "t": null
    },
    {
