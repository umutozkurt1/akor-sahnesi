{
  "slug": "hayki-b1r",
  "artist": "Hayki",
  "title": "B1r",
  "key": "F",
  "capo": 0,
  "rhythm": null,
  "youtubeId": null,
  "hasSyncedLyrics": false,
  "lines": [
    {
      "lyric": "Beyaz bir altın pamuk, Adanam'dan hediye",
      "chords": [
        {
          "chord": "Fm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Tüm dünya aşıktır, bilirsin; Van'daki kediye",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gökteki Ay; tıpkı bizim Kütahya'da porselen",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Güneş doğarken İstanbul'dan bir başka yükselir",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Artvin'de bal kadar tatlı, Afyon'da kaymak",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ne müthiş; Antalya'da deniz keyfi, Uludağ'da kaymak",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ya da Erzurum'da; Palandöken, Kilis'te yorgan diker halkım",
      "chords": [
        {
          "chord": "Ab",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Zonguldak'ta kömür yüz karartır",
      "chords": [
        {
          "chord": "G",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Pek sevilir bur'da, Kastamonu kır pidesi",
      "chords": [
        {
          "chord": "Fm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ve ya bir simit kap otur seyret, Üsküdar'da Kız Kulesi",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Mersinde Kız Kalesi, Rize'den çaylar",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Geçtiysem illa içmişimdir Susurluk'tan ayran",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ve bayrak dalgalanır gülümser Çanakkale",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Mardin'de taş evler, her derde devadır Pamukkale'm",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sivas'ta kangal korur köyü, Edirne'de pehlivan",
      "chords": [
        {
          "chord": "Ab",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yolun düşerse bir gün tadıp Erzincan'dan peynir al",
      "chords": [
        {
          "chord": "G",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Denizli'den öten horoz, sekiz ilden duyulur",
      "chords": [
        {
          "chord": "Fm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bu bizim soframız, buyurun hepimizi doyurur",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Huyumuz suyumuz bir, kazılan kuyumuz girme",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kıbrıs'ta bizimle elbet Lefkoşa ve Girne",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hep aynı yerde düştük yere, hep aynı yerde ezildik",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ne Azeri ne Türkmen ayrı, ne Lazı, ne Kürdü",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sen parçala ve kirlet ülkem kültürlere birlik",
      "chords": [
        {
          "chord": "Ab",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Amaç hep bir ağızdan burası yurdum diyebilmek",
      "chords": [
        {
          "chord": "G",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Aşık Seyrani, Mimar Sinan, Erciyes, Kayseri",
      "chords": [
        {
          "chord": "Fm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gaziantep türküleri, bahçalarda mor meni",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gel Paris'ten, Şanlıurfam topraktan evler",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ocakta mırra pişerken ozanlar mani söyler",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sırtımda Nemrut, bir kolum cendere adım; Yaman",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kekik kokar Balıkesir, Iğdır'dan söker şafak",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Akkuş, Aybastı, Çatalpınar, Fatsa, Ordu",
      "chords": [
        {
          "chord": "Ab",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Tüm sokaklarım tozlu ben Diyarbakır'da doğdum",
      "chords": [
        {
          "chord": "G",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Eğer Karadeniz'den geçerseniz, Trabzon'da durun",
      "chords": [
        {
          "chord": "Fm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Dinle İskoçya'nın gaydasını kıskandırır tulum",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Konya'dan seslenir Mevlana Celaleddin Rumi",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bugün kimse yüz dönmüyor bize Nasreddin gibi",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Elazığ'da Gakkoşum, Aydın'da Efe",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bende dokuz dağın gücü, mermi göğsümden teper",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bir tek Pir Sultan Abdal konuşturur bağlamayı",
      "chords": [
        {
          "chord": "Ab",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bana bir metris, bir Malatya hatırlatır Ahmet Kaya'yı",
      "chords": [
        {
          "chord": "G",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bayburt, Bolu, Ankara, Amasya ses ver",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Samsunda tütün sarıp, Karaman'da koyun gütsem",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Tekirdağ'da rakı içsem, Gümüşhane'de kuş burnu",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hiç görmesem de, Muş'u anlattılar, hoş buldum",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ardahan, Hakkari, Siirt; el kaldırın gardaş",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "En iyi dostum Hataylı, en kahraman Maraş",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ne için kavga ne için savaş bu senin yurdun",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sakarya, Osmaniye, Dersim ve Burdur",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Tokat'ın boynuna gerdanlık Yeşilırmak",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hala Kars'ın bağrında, doksan binşehit",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Cudi, Silopi, Şırnak, Serhat Seyit",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Tam 923 ilçe 81 şehir; İzmir'de iç, kordonda sız",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ayrı keyif tabii, yiğit Ağrı'nın başında erir mi kar?",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sıkı giyin, tam on yıl üstüme geldiler gıpta edip",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Adım Kırklareli, hiç sıkmadım düşman eli",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bitlis'te beş minare Kocaeli'm gönlüm gibi",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kimi bindallı giyer Niğde'de, yazma örer kimi",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kazma kürek, toprak döver çiftçi; izler paraya boğulan",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Keşke şimdi görüp yazsa Karacaoğlan",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bu da azsa Muğla, Sinop, Yozgat, Uşak",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Dur; silah yerine sanat, saz ve sözle kuşan vur",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yeni nesil, yeni kuşak, yeni alet, yeni suça, gel dedikçe geri koşar kul",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Zoru başar, tut, bütün bu güzellikler senin",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bir gün birlikteysek eğer o gün el üstünde eliz",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Nevşehir'de bir arif tanıdım, tek maaşı ilim",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Edep, haya; adı Hacı Bektaş-i Veli",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Düzce, Karabük, Bartın, Yalova, Batman",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Öyle Isparta'nın gülündeki dikenler her ele batmaz",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yeşil ve mavi kucaklaşır Giresun'da tüm gün",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Doğanın en masalsı yüzü Kapadokya, Ürgüp",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Henüz askerdim; bir sabah soludum Spil'i",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Tüfek çatıp; süngü taktım, yere koyarken canımı",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Düşüp koşarken tanıdım seni, toprağında kanım",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sen ki ben giderken arkamdan bakıp ağlayan kadın",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bingöl ya da Çapakçur'da bir kahvede sabahçıyım",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Aksaray, Mamasun'da olta tutan balıkçı",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Çorum'da dolmacıyım, Kırşehir'de bakırcı",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ne faşistim, ne gerici, ne bölücü, ne ayrımcı",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bilecik, Çankırı, Eskişehir, Kırıkkale",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Koyun koyuna yattık, hem de yetmiş milyon kere",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Çözüm mü kin ve hır? Bakın bizim bu kar ve kır",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yarınlar hür ve bir darılma ,küsme, gül, sarıl",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gitme dur kal akmasın kan, kalkmasın el ölmesin er",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Anam görmesin dert, bırakma bölmesinler",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ben neysem öylesin sen, çünkü; bir yemin ve tövbemiz",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Her nerede olursan ol bir; gönül ve gövdemiz",
      "chords": [],
      "section": false,
      "t": null
    }
  ],
  "enriched": false
}