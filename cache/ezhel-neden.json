      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Tökezle düş diye başımda bekler her puşt",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sıcaklığa öyle muhtacımki olcam zerduşt",
      "chords": [],
      "section": false,
      "t": null
    },
    {
