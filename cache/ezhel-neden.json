      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bakınca fiilen, insanlar iğrenç",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yer denen şu şaheserden hiç eser yok iyiden",
      "chords": [],
