      "chords": [
        {
          "chord": "Bm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Memur maaşı torbacının cirosuna göre,",
      "chords": [
        {
          "chord": "Bm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Değişiyo diyo aga tabi kilosuna göre,",
      "chords": [
        {
          "chord": "Bm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Tabikide kızın bide filosuna göre,",
      "chords": [
        {
          "chord": "Bm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yen yuan dolar paund eurosuna göre,",
      "chords": [
        {
          "chord": "Bm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ding dong kapı çalar faturanı öde,",
      "chords": [
        {
          "chord": "Bm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
