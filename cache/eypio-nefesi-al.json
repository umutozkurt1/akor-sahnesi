  "lines": [
    {
      "lyric": "Ateşi ver diyo yak sigara,",
      "chords": [
        {
          "chord": "Bm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Olsam bile diyo sen fukara,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Güvenme kimseye götü duvara daya,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Çıkmış diyo sana gene zıvana,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "İmanıma değil sana limanıma gel,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yanaşta yanıma bi divanıma gel,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kabayım arasıra kibarıma gel,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sana kim ne derse desin, İnadına gel!",
      "chords": [
        {
          "chord": "D",
          "col": 5
        },
        {
          "chord": "B",
          "col": 25
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "İnadına,İnadına,İnadına gel,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kopuyoz gece kap biranıda gel,",
      "chords": [
        {
          "chord": "Bm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Dayanınca kapısına Viyana’da sel var,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Al Üsküp Kosova’yı Tiran’ıda gel,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gel gel gel! Al gel İran’ıda gel,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Red-Kit yanımda dedim Averel’e gel,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Devlet yanımda dedim paralele gel,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Para ver diyo yeter aga ara gene gel.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
