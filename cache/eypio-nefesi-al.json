      "chords": [
        {
          "chord": "Bm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sen bana sakın kızmayasın,",
      "chords": [
        {
          "chord": "Bm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hoca diyo tuttu gölün mayası,",
      "chords": [
        {
          "chord": "Bm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
