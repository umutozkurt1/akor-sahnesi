    {
      "lyric": "Bana küsme!",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gönülde söz, ciğerde köz, yeminde göz, deminde öz gibiyim, bazen yiğitte mitralyöz gibiyim.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bazen düz gibiyim, bazen gülen bi yüz gibiyim, güz gibiyim.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bazen türkü bazen köleyim siyah ve blues gibiyim…",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bana küsme!",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Evet bazen öküz biriyim ama padişahlara pürüz biriyim, namerde baya lüks biriyim.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Tam deliyim, halüs gibiyim, fakülteliye kampüs gibiyim,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yavşaklara kaktüs biri, sar beni bak papirüs gibiyim…",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bana küsme!",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kış değilim, yaz gibiyim.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Az değilim, ayaz gibiyim, maraz biriyim.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Caz gibi biraz ama saz gibiyim.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bazen kabul kalas biriyim, tabii ki hıyara klas biriyim.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yedekte değil hep as biriyim, bazen yırtılmış kas gibiyim",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bana küsme!",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Tabulara mıhlanana hilti misali duygu döven bi cihaz gibiyim",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yanan haz gibiyim, hiç sıkılmadığın bir vaaz gibiyim",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "İtiraz gibiyim, miras gibiyim, gençken tutamadığın yas gibiyim",
      "chords": [],
      "section": false,
      "t": null
