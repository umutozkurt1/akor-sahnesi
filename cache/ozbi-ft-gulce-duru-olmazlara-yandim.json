          "col": 6
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Çamur bulur yönü, arar günü gönül…",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        },
        {
          "chord": "G",
          "col": 4
        },
        {
          "chord": "Dm",
          "col": 6
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sanık hisler kara merhem çalar her dem yaşanan ne?",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        },
        {
          "chord": "G",
          "col": 4
        },
        {
          "chord": "Dm",
          "col": 6
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Alışan ben, karışan kim? – Bir sersem, yaşanan ne?",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        },
        {
          "chord": "G",
          "col": 4
        },
        {
          "chord": "Dm",
          "col": 6
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bulut beyaz umut değilHangi yas, hangi kin?",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        },
        {
          "chord": "G",
          "col": 4
        },
        {
          "chord": "Dm",
          "col": 6
        }
      ],
      "section": false,
      "t": null
    },
    {
