        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bir yağmurdan, bir mahmurdan hesap sorar",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        },
        {
          "chord": "G",
