    },
    {
      "lyric": "Bak yol gidiyor, son geliyor",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yine yanlışlıkla, tek kalmışlıkla yazıyorum anlık.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Dünya dönüyor mu arsızlıkla, her çapsızlıkla sızıyor mu dipsiz rüya?",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Çok çok çekilir şansız kura, tükenir sarhoşluklar, bağırır tüm boşluklar.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yapılır nahoşluklar, ayıp mı nahoşluklar?",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kime göre nahoşluk lan!",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bir bokluk var.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Biliyon çok yokluk var ama çok zengin var.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yani çok bokluk var…",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kime göre diyemeden evimize niye gece girdiğimizi soran herkese söve söve bitemedi yargılayanlar.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sevemedi bizi hiç sevgiyi yaftalayanlar,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Korkuyu pompalayanlar.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ele güne rezilliğimiz olsun size ne! İçiyoz kime ne!",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Varsın diye yaşamıyım mi lan hıh!",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Deli mi ne, veli mi ne, geri mi ne diye düşün ya da sus gir evine!",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sine sine geliyo bu gençlik, güveniyor yüreğine kalemine.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Olmaz diyon ya sen gelicem tükürüp polisin sirenine",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Olmaz diyon ya yine sen gelip ateş etçem frenine!",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bir dert denizine gömülür dünya, daha sesimize çığlık yaslamadık,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Biz izimizi görmeyi düşündük hep düşümüze artistlik taslamadık.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Dizimizi kanattı heyecanımız hep hiç gücümüzü senle kıyaslamadık.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Özümüzü anlara armağan ettik, bulunan yolları saklamadık ki…",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yol yine kapandı, yine bulandı, niye bulandık yaralarla.",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        },
        {
          "chord": "G",
          "col": 4
        },
        {
          "chord": "Dm",
          "col": 6
        },
        {
          "chord": "Am",
          "col": 9
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sigaram bana küsme…",
      "chords": [
        {
          "chord": "G",
          "col": 0
        },
        {
          "chord": "Dm",
          "col": 2
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sol omuzumdan bir serçe havalandı yaralarla.",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        },
        {
          "chord": "G",
          "col": 4
        },
        {
          "chord": "Dm",
          "col": 6
        },
        {
          "chord": "Am",
          "col": 9
        }
      ],
      "section": false,
      "t": null
    },
    {
