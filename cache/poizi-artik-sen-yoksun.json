  "lines": [
    {
      "lyric": "Gerçekler ağır gelir, bırakmaz yakamı",
      "chords": [
        {
          "chord": "Cm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kaybederim yine, fark etmez bugünle yarın",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Değişiyo' hayatımız, yolun sonundayım",
      "chords": [
        {
          "chord": "Bb",
          "col": 17
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Burada gülüyo'lar, babacım, inanamadım",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ölüme koşuyorum da henüz yorulmadım",
      "chords": [
        {
          "chord": "Ab",
          "col": 21
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bu sırtımdakilerden daha kurtulamadım",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bari sen unut, bi' seni unutamadım",
      "chords": [
        {
          "chord": "Bb",
          "col": 26
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Uzaklardayım ama gelirim adım adım",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Artık sen yoksun",
      "chords": [
        {
          "chord": "Cm",
          "col": 16
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "İçimde bi' dert \"Çıkar beni\" der",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bırak, her şeyin olsun",
      "chords": [
        {
          "chord": "Bb",
          "col": 28
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "\"Zamanla biter zaman gibi\" der",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sen de çok zorsun",
      "chords": [
        {
          "chord": "Ab",
          "col": 20
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kafamda bile susmaz deliler",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ona her şeyi sordum, İstanbul duysun",
      "chords": [
        {
          "chord": "Bb",
          "col": 23
        }
      ],
      "section": false,
      "t": null
    },
    {
