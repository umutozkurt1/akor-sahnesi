  "capo": 0,
  "rhythm": null,
  "youtubeId": null,
  "hasSyncedLyrics": false,
  "lines": [
    {
      "lyric": "Sel almış gözlerimin ferini, tam ortadayım,",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kanımca, sessizliğin yamaçlarından bu merak,",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ankara'nın sisli sabahı, gözlerim bumerang,",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kaçırsam da senden, sana dönecek susarak.",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yol almış vicdanının puslu merceğinden,",
      "chords": [
        {
          "chord": "Dm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sana bakmak aynı ölüm gibi, farkı yok gerçeğinden,",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ben aynı yerdeyim de tadım yok,",
      "chords": [
        {
          "chord": "Dm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Eskisinden farklı tüneldeyim yine de, şüphem yok geleceğinden.",
      "chords": [
        {
          "chord": "Em",
          "col": 11
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sanki farklı gibiyiz şu günlerde dimi?",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bugün aynaya baktığında, kendine sor kimim?",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bugün aşkı ölüm, ölümü aşk sanıyor kibir,",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Lakin aşkı derde, derdi bana satıyor kimi.",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bugün istersen al be gözüm yoluna feda başımla,",
      "chords": [
        {
          "chord": "Dm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sen sanıp da, bağrıma bastığım taşım var,",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hasret gidermek zor, bir gözde yaşımla,",
      "chords": [
        {
          "chord": "Dm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bir gün günbatımında geri dönersem hiç şaşırma.",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Nak.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Okuyabilmek gözlerinden aşkı;",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Mevsimlere sormak gibi bir ömrü, git başımdan!",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Tozlu bir mektup gibi eski bir yılbaşından,",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Şimdi sen tahmin et, yokluğun kaç yaşında?",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ağla biraz, gözlerin tutuşsun,",
      "chords": [
        {
          "chord": "Dm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bir yangın ol isterim, külleri umutsuz,",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Birazcık sen hüzünlen, ses telim ağrıyor, sus!",
      "chords": [
        {
          "chord": "Dm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ben değilim, kader huzursuz.",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    }
  ],
