  "hasSyncedLyrics": false,
  "lines": [
    {
      "lyric": "Sabahın beş buçuğu, kendimi mesafelere odakladım",
      "chords": [
        {
          "chord": "Bm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Uykular haram, orada morarıyorken dudakların",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ve neydi kollarımda başka birine göz atmanı gerektiren?",
      "chords": [
        {
          "chord": "F#",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ne acı hiç bitmiyor tuzakların",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Uykusuzluk benim, bilmek istiyosan buyur",
      "chords": [
        {
          "chord": "G",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bi' vakit değişmedim, göremesen de buyum",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Çok bi' şey üzülmedim, nasılsa gelirsin",
      "chords": [
        {
          "chord": "F#",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ben her ihtiyaç duyduğunda tükettiğin suyum",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Oradan anla baharı, gurbeti yemek yapıp kaşıkladım",
      "chords": [
        {
          "chord": "Bm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bi' çocuk gözlerinde anlamasın uçurtmanın",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "A ölüm B ölüm faydası yok bu şıkların",
      "chords": [
        {
          "chord": "F#",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Belki de iyi gelir sana İzmir'in ışıkları",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Belki de kötü olur bu, saçların ağarır",
      "chords": [
        {
          "chord": "G",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bi' kar tanesi olup yeniden özlemek baharı",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Burda bir kez daha başlıyosa gurbet imtihanı",
      "chords": [
        {
          "chord": "F#",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ölmek değil bi' daha görmek intiharım",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gülüm anla beni, yeniden özlemek seni",
      "chords": [
        {
          "chord": "Bm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Aynı siyah beyaz ve aynı güneş, ay gibi",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ve aynı yerde aynı havayı soluyorken de dahi",
      "chords": [
        {
          "chord": "F#",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Seni kaybettiğim limana tеkrar dönememek gibi",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ne olur anla beni, yeniden özlemek seni",
      "chords": [
        {
          "chord": "G",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Aynı gece gündüz ve aynı ellerin gibi",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ve aynı yerde aynı havayı soluyorken de dahi",
      "chords": [
        {
          "chord": "F#",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Beni defalarca öldürsen de ölememem gibi",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bi' yanım dönmemeyi hiç istemeyen tren",
      "chords": [
        {
          "chord": "Bm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Diğer yanım sen, işte sen yanım diyor ki diren!",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ne yapcağımı şaşırdım ben canım",
      "chords": [
        {
          "chord": "F#",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yollarına feda etsem tüm ömrümü yine de gözlerimde bi' nem",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hala seçemediğim yollar var",
      "chords": [
        {
          "chord": "G",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bi' daha gelir misin adını tonlarsam?",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bu gidiş ziyan etti ruhumu, ayaklarım tutmasa da",
      "chords": [
        {
          "chord": "F#",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gelirim evet bir kaç adımı zorlarsam",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hayat bi kaşık su, elleme dur yaram derin",
      "chords": [
        {
          "chord": "Bm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yokluğun en zirvesine taşıyansın kadın beni",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hissetmesen de günlerce sen tıkadın beni",
      "chords": [
        {
          "chord": "F#",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ben hala anlamıyorum nanköre aşk nasıl denir?",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "(Nasıl mı?) Acıyı senle buldum",
      "chords": [
        {
          "chord": "G",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Aynı anda hem bi' melek hem de bu kalbimin kurdu",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yedin de bitirdin şu ömrümü, hiç yetmedi mi?",
      "chords": [
        {
          "chord": "F#",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Neyse, hoşçakal sen gözlerimin nuru",
