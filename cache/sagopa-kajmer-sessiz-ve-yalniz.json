    {
      "lyric": "1.KISIM:",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hayatın gücü onunkinin hep üstü,o nedenle küstü.",
      "chords": [
        {
          "chord": "C#m",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Saçlarımın masalı gibi,siyahtan beyaza döngü.",
      "chords": [
        {
          "chord": "G#m",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Çekilirken umutlarımın önüne sürgü,içim sürgün.",
      "chords": [
        {
          "chord": "C#m",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Çünkü herkes özgür,bana tel örgü.",
      "chords": [
        {
          "chord": "G#m",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yalnız yalnızın halinden anlar yalnız.",
      "chords": [
        {
          "chord": "C#m",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Cılız ağacın tenine balta değdi.",
      "chords": [
        {
          "chord": "G#m",
          "col": 6
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kaldıramadı bunu görmeyi,kaydı gitti yıldız.",
      "chords": [
        {
          "chord": "C#m",
          "col": 25
        }
      ],
      "section": false,
      "t": null
    },
    {
