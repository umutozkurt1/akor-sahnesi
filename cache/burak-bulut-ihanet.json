  "rhythm": null,
  "youtubeId": null,
  "hasSyncedLyrics": false,
  "lines": [
    {
      "lyric": "Beni anlamaman tek mesele, hayatım bi' türlü girmiyo' düzene",
      "chords": [
        {
          "chord": "Em",
          "col": 8
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Biraz olsun yürekli ol, hadi \"Sevmiyorum seni\" desene",
      "chords": [
        {
          "chord": "Bm",
          "col": 9
        },
        {
          "chord": "Em",
          "col": 44
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Fayda eder mi ki ecele yaralar, dün gibi doğsa da geceme?",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hayallerim göçebe, aşk bilmece gibi çözene, ah",
      "chords": [
        {
          "chord": "Bm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Müsaade et, yalan olurum, yüreğim, söyle, nedir? Alırım",
      "chords": [
        {
          "chord": "Em",
          "col": 5
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Son nefesinde boğulurum, zaruriyim, ziyan olurum",
      "chords": [
        {
          "chord": "Bm",
          "col": 0
        },
        {
          "chord": "Em",
          "col": 48
        },
        {
          "chord": "G",
          "col": 69
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Katilim ama masumum, aşk tek gerçek kanunum",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Üzgünüm seni üzdüğüm için, ihanetine mağdurum",
      "chords": [
        {
          "chord": "Bm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bi' kеre eden bi' daha еder ihanet",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ama üzülme, anıların üstüne yaraları ilave et",
      "chords": [
        {
          "chord": "Bm",
          "col": 23
        },
        {
          "chord": "Em",
          "col": 71
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ve gülümse, \"Unuttum\" de bana, \"Unuttum, yalandı\" de, inanırım",
      "chords": [
        {
          "chord": "C",
          "col": 27
        }
      ],
      "section": false,
      "t": null
    },
    {
