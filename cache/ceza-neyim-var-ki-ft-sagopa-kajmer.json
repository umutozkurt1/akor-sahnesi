        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bir tarafta Gökkuşağı, öbür tarafsa kör",
      "chords": [
        {
          "chord": "Em",
          "col": 32
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sınırda kalmışlardanız biz, hep sınıfta kalmışlardan çok uzaktayız",
      "chords": [
        {
          "chord": "D",
          "col": 0
        },
