          "col": 86
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sıkıntı çekmişlere yakın bir yerde",
      "chords": [
        {
          "chord": "C",
          "col": 13
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Çölde kazanılan zaferler hepsi kanla yazılır",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ahmak olmasaydın insan, tüm zaferler dostça kazanılırdı",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Her gün doğumundan gün batımına",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Her geceden gündüze işlenen bir suç var her bi' yerde bahçemiz var",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Cümle derde ol deva diye dua ederdi",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Günde bin defa, fayda yok, bu çok fena, çare yok",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bu bir bela, sanki yoktu başta",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hepsi kalsın aleminde Sagopa ve Ceza; Rap için bir pranga",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "İlham perilerim, yorgun ellerim",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ve miskin armağan düşüncemin yanında bir emanetim bu bedene zor",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yıllarım bir yetki verdi, etki tepki oldu",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kendimin hudutlarında bir çiçektim, mordum",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Onca tarla doldum",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bir şafaktım askerin duvarda yırttığı",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bir takvim yaprağında geri kalan umut, rakamlar oldum",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "İstediğim yerdeyim",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bir iki dak'ka verin bu adama, konuşamaz dilim tutuldu",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Fincan kahvem hatrına saydım",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bir yudumluk aşkın deli sarhoş",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Komplo orduların gardiyanların",
      "chords": [
        {
          "chord": "D",
          "col": 0
        },
        {
          "chord": "Am",
          "col": 32
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Neyim var ki rapten gayrı",
      "chords": [
        {
          "chord": "Bm",
          "col": 0
        },
        {
          "chord": "C",
          "col": 18
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Akarsular bu bahçelerde kurtulur zebanilerden",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Akmayan suyu bile çölde, çeşmeler var her bi' yerde, bul",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Olmaya çalış bi' kul, istediğimiz yekti sulh",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Olmasın altında çul, olmasın paran ve pul",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gene de gül bir kez, be bi' kere gül ve senede bir de olsa",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gül bu çölde yeşerir elbet",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Savaş biter ve biz de sınırın ortasında kaybolur",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gider de sözlerimizi ve rap'imizi miras bırakırız yeter",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ey, rap'in sebepsiz anlamı, damarlarımda gezine dur",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Şakaklarımda kan birikmiş ben bi' cümlelik bi' nokta değilim",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Şiirlerimle gömülecek adım satırlarımda geçmişin tokat izleri",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "(Anlat!) Ellerimde kara kalem, kara gözüm seyirde",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yollarımda yolunu gözlediğim bi' yolcum, mağlubum",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yaradan Allah'ım, gençliğime mahcubum",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Oyuncak bir tabanca elime hakim oldu, çok alıştım",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ben bugünde yaşıyorum, yarın da meçhulüm",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bin yasak ve bin cezayla ilelebet mi yaşıyorum",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bir bal olsam, damlasam",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bu yeryüzünde bir kalbim, nefretim ve var olan bin cezam",
