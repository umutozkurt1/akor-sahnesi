  "hasSyncedLyrics": false,
  "lines": [
    {
      "lyric": "Aynı ben mi uyandım bugün?",
      "chords": [
        {
          "chord": "Dm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bugün ne kadar benziyorum kendime",
      "chords": [
        {
          "chord": "Gm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hangi dertten yakındıysam ben, hepsini çektim",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        },
        {
          "chord": "Gm",
          "col": 67
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yakındım zaten hepsine",
      "chords": [
        {
          "chord": "Am",
          "col": 4
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kurduğum hayal için başkasını yakmak mı?",
