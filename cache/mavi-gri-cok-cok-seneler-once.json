  "hasSyncedLyrics": false,
  "lines": [
    {
      "lyric": "Bu kalp ne zaman sever, ya da terk eder",
      "chords": [
        {
          "chord": "Gm",
          "col": 5
        },
        {
          "chord": "F",
          "col": 19
        },
        {
          "chord": "Eb",
          "col": 49
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hiç kararı çizgisi yok mu?",
      "chords": [
        {
          "chord": "F",
          "col": 7
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "İnsan bulamaz neden, ne fark eder?",
      "chords": [
        {
          "chord": "Gm",
          "col": 0
        },
        {
          "chord": "F",
          "col": 14
        },
        {
          "chord": "Eb",
          "col": 41
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hep sonunda ayrılık yok mu?",
      "chords": [
        {
          "chord": "F",
          "col": 8
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sustum içime attım, sen üzülme diye bahsetmedim",
      "chords": [
        {
          "chord": "Cm",
          "col": 0
        },
        {
          "chord": "Dm",
          "col": 42
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kırıldım sana ama bu hâle hiç gelmedim",
      "chords": [
        {
          "chord": "Eb",
          "col": 0
        },
        {
          "chord": "F",
          "col": 30
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Şimdi onlasın ya, sever mi seni ben gibi?",
