  "lines": [
    {
      "lyric": "Yağıyor yine kasveti kar gibi gecenin.",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Normalinden yüklü ağırlığı her hecenin.",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Garantisi yok bir sonraki nefesin.",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bir kin yemlenir yaşattıkları için içimde.",
      "chords": [
        {
          "chord": "D",
          "col": 0
        },
        {
          "chord": "Bm",
          "col": 19
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gezerim beyaz kuzularını kaybetmiş çobanın sessiz köyünde.",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Herkes bir gün batacak el ele güneşle.",
