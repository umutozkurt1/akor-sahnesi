        {
          "chord": "C",
          "col": 0
        },
        {
          "chord": "D",
          "col": 18
        },
        {
          "chord": "Bm",
          "col": 31
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kelepçesini açtım öfkemin, dedim: ‘Artık serbestsin’",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Parçaladı dizlerimi yumruklarım, hırsımı çıkaramadım pek net.",
      "chords": [
        {
          "chord": "C",
          "col": 0
        },
        {
          "chord": "D",
          "col": 20
        },
        {
          "chord": "Bm",
          "col": 29
        }
      ],
      "section": false,
      "t": null
    },
    {
