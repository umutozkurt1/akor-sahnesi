  "lines": [
    {
      "lyric": "Bir başkası duysun beni",
      "chords": [
        {
          "chord": "Bm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ya da bir başkası anlasın hissettiğimi, istemem.",
      "chords": [
        {
          "chord": "F#m",
          "col": 0
        },
        {
          "chord": "A",
          "col": 41
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Seni anlatıp durdum insanlara.",
      "chords": [
        {
          "chord": "G",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Başkası sevsin beni",
      "chords": [
        {
          "chord": "Bm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ya da bir başkası uyansın kollarımda, istemem.",
      "chords": [
        {
          "chord": "F#m",
          "col": 0
        },
        {
          "chord": "A",
          "col": 39
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Seni yeni bıraktım topraklara.",
      "chords": [
        {
          "chord": "G",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sana acıyarak baktıklarında dayanamıyorum.",
      "chords": [
        {
          "chord": "Bm",
          "col": 0
        },
        {
          "chord": "F#m",
          "col": 28
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "'Aslında burada o' diyorum.",
      "chords": [
        {
          "chord": "A",
          "col": 19
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ama beni de susturuyorlar en sonunda.",
      "chords": [
        {
          "chord": "G",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Geri getiremem ama bitmesin de.",
      "chords": [
        {
          "chord": "Bm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Beni de düşün, yanlış anlamanı istemem.",
      "chords": [
        {
          "chord": "F#m",
          "col": 0
        },
        {
          "chord": "A",
          "col": 32
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Seni bu son anlatışım insanlara.",
      "chords": [
        {
          "chord": "G",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gel, ve uzan omuzlarıma. Gidelim umutlara doğru.",
      "chords": [
        {
          "chord": "Bm",
          "col": 0
        },
        {
          "chord": "F#m",
          "col": 25
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Alalım bulutları da. Ver elini, korkma hiç ne olur.",
      "chords": [
        {
          "chord": "A",
          "col": 0
        },
        {
          "chord": "G",
          "col": 21
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gelirim bir gün yanına, yaşamak gelmiyor içimden.",
      "chords": [
        {
          "chord": "Bm",
          "col": 0
        },
        {
          "chord": "F#m",
          "col": 24
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yazıyorum hep seni bak, okuyorum göklere doğru.",
      "chords": [
        {
          "chord": "A",
          "col": 0
        },
        {
          "chord": "G",
          "col": 24
        }
      ],
      "section": false,
      "t": null
    },
    {
