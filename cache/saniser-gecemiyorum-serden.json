        {
          "chord": "Cm",
          "col": 0
        },
        {
          "chord": "Ab",
          "col": 37
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ben zaten öldüm bin kere huzurunda",
      "chords": [
        {
          "chord": "Fm",
          "col": 8
        },
        {
          "chord": "Bb",
          "col": 28
        },
        {
          "chord": "Cm",
          "col": 48
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Dönmekse kusurum olur, git, kabul etmem",
      "chords": [
        {
          "chord": "Cm",
          "col": 0
        },
        {
          "chord": "Ab",
          "col": 42
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Emin ol yağmur yağar şarkılar sustuğunda",
      "chords": [
        {
          "chord": "Fm",
          "col": 13
        },
        {
          "chord": "Bb",
          "col": 36
        },
        {
          "chord": "Cm",
          "col": 51
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bugün, yarın",
      "chords": [
        {
          "chord": "Cm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bir hayat geçti",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "İnanılacak bi' yalan seçtim",
      "chords": [
        {
          "chord": "Gm",
          "col": 6
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Eğdim başımı yürüdüm",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gezdim taşını, toprağı gördüm; sanırım sevdim yarışı",
      "chords": [
        {
          "chord": "Fm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kendimi devirdim onca sefer; bir kere getirmedi ruhuma devrim barışı",
      "chords": [
        {
          "chord": "Cm",
          "col": 15
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Durdu zaman, günleri mevsim sanışım",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Önümde tonla hayal vardı; aptalca gurulanıp teptim yarını",
      "chords": [
        {
          "chord": "Gm",
          "col": 32
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kaybettim şehirde sessiz yanımı",
      "chords": [
        {
          "chord": "Fm",
          "col": 19
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "İçimde hep çığlık var",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yazmalıyım çığlıklarımı; boğmalıyım sığlıklarımı",
      "chords": [
        {
          "chord": "Cm",
          "col": 26
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "27 sene çektim kahırı. Mutsuzluğun eksik tanımı",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hayatımın içine ettim sanırım",
      "chords": [
        {
          "chord": "Gm",
          "col": 28
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Param da bitti; belki bu ay sonu evsiz kalırım",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Anlayacağın yolum taşlı; karanlığım haneme dolup taştı",
      "chords": [
        {
          "chord": "Fm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Her saniye ağlamaklıyım. Büyümeyi beklerken çocuklaştım",
      "chords": [
        {
          "chord": "Cm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Cennet yağsa naçar yine bana düşer ah almak",
      "chords": [
        {
          "chord": "Cm",
          "col": 0
        },
        {
          "chord": "Gm",
          "col": 60
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Susarım, seni anlatmam",
      "chords": [
        {
          "chord": "Fm",
          "col": 24
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Canım yanar ah, yar",
      "chords": [
        {
          "chord": "Cm",
          "col": 22
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gülesin varsa naçar yine bana düşe ağlatmak",
      "chords": [
        {
          "chord": "Gm",
          "col": 64
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yanarım yine kar yağmaz omuzlarıma",
      "chords": [
        {
          "chord": "Fm",
          "col": 24
        },
        {
          "chord": "Cm",
          "col": 58
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Alem, acı yaram adını keyfine yazarım",
      "chords": [
        {
          "chord": "Cm",
          "col": 0
        },
        {
          "chord": "Gm",
          "col": 35
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ölürüm iki gece dünya",
      "chords": [
        {
          "chord": "Fm",
          "col": 29
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yanar azar hazanım",
      "chords": [
        {
          "chord": "Cm",
          "col": 28
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Alem, acı yaram adını keyfine yazarım",
      "chords": [
        {
          "chord": "Cm",
          "col": 0
        },
        {
          "chord": "Gm",
          "col": 35
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ölürüm iki gece dünya",
      "chords": [
        {
          "chord": "Fm",
          "col": 29
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yanar azar hazanım",
      "chords": [
        {
          "chord": "Cm",
          "col": 28
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Geçemiyorum serden, kar kış dolu sergen. Ayaklarım buz tutmuş;",
      "chords": [
        {
          "chord": "Cm",
          "col": 0
        },
        {
          "chord": "Gm",
          "col": 80
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ben nedense hep şikayetçiyim terden",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Burada cambaz olmak gerekmiş; burada, zayıfı ezmek erdem",
      "chords": [
        {
          "chord": "Fm",
          "col": 13
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yürümem bu ipte; bu ip, fazla alçak ve fazla yüksekte yerden",
      "chords": [
        {
          "chord": "Cm",
          "col": 21
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hayat, olamıyorum sana razı",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Nur beni geçsin sana yağsın",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bir gün en sevdiklerinin söyledikleri salakça yalanları yakalarsın",
      "chords": [
        {
          "chord": "Gm",
          "col": 24
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ben söyleyemem; yanar ağzım",
      "chords": [
        {
          "chord": "Fm",
          "col": 8
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Artık yatağında bir o yana, bir bu yana dönmekten bıkarsın;",
      "chords": [
        {
          "chord": "Cm",
          "col": 68
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "O gece dönecek üçüncü bir yan ararsın",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bu sebepten kaç yıl doğdu güneş?",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sonunda hava karardı",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Haziran sularında uyandım; hatam yoksa sabaha karşı",
      "chords": [
        {
          "chord": "Gm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Rap dediğin senin yok olmak; haram yolda aramak arşı",
      "chords": [
        {
          "chord": "Fm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Rap de hayat gibidir dostum; paran yoksa başaramazsın",
      "chords": [
        {
          "chord": "Cm",
          "col": 0
        }
      ],
      "section": false,
