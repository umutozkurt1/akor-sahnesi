  "lines": [
    {
      "lyric": "H ayat garip…",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Mesela yürekler çukur, içine düşenler vakur, geceyi bilenler",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "çamur, ileri gidenler durun!",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gar’da çalınmış bavul. Geriye gidenler çalıp çoktan yarılamış yolu…",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hayat garip…",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bir gün köşeye sinmiş ağlıyor, bir gün yaşlı güneşe sinirlenmiş bağırıyor.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bir gün hayallerini toparlayıp kapıyı çekip çıkmış sonra dönmüş arkaya sümkürerek bağırıyor…",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Garip bu hayat…",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ölümü tercih etmiş sevdiği her halde bundan sonra delirmiş unutmuş ölmeyi.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gülümsemiş demişler ‘’Al bu senin kimliğin ve bi öğretmensin ilkin öğreticen yenmeyi’’",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hayat düşünceli…",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ne zaman öğrenmişti bilmeyi dedi ki ‘’Ne ara bildim birini kaldırıp devirmeyi.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hangi gündü, hangi günde doğdu bilgi? Evet bi duygu geldi ama anlamayı hangi duygu sildi?",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hayat endişeli…",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Dedi ki ‘’Yok bir şeyim az önce sorguladım ve şimdi dört köşeyim.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kimle ters düşeyim yaşarken ilk neşeyi, gürül gürül akan bir nehir var mı aşk içeyim’’",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hayat masum…",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hiç unutmaz ki ilk geceyi.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Çünkü demiş ‘’Yağmur yerine ben geçeyim’’",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bir kere demiş bunu ve sonra gürlemiş bulut ‘’Bilmiyorsun bir fırtınanın savurduğunu kaç kişiyi’’",
      "chords": [
        {
          "chord": "C",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
