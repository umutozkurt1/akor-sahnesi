  "lines": [
    {
      "lyric": "Geçen yıllar geçerken uğradılar yine geçende.",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Onlar anlatırken içim geçer de,bu içimden geçenler gelir geçer de.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "''Geç bunları içim!'' desem de,geç kalınmış bazı şeyler için de.",
      "chords": [
        {
          "chord": "Em",
          "col": 40
        },
        {
          "chord": "G",
          "col": 79
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ne için için içini yer de? kime içini döksen? nerde?",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Geçersizleşiyor kurallar geçimsizlik geçmediğinde.",
      "chords": [
        {
          "chord": "C",
          "col": 0
        },
        {
          "chord": "Em",
          "col": 69
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Geçerim es geçiştirmek istediğimde,geçit bulurum bir şekilde",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "geçmeyi dilediğimde.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gerçek,bilmeyi istediğin müddetçe senle yanında.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bir hayalet gibi dolanırken kimse değil ki farkında.",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Geçerli sebepler fabrikası seri üretiminde.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Peki şu yalanlar kimin denetiminde?",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "İnsanın ne kadar ucuz olduğunu anlardın olsa fiyat etiketi",
      "chords": [
        {
          "chord": "F",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "üstünde.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Üstüne üstlük ikinci el insanlar vitrinde,barkodları üzerlerinde.",
      "chords": [
        {
          "chord": "Em",
          "col": 62
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sen aklına ihanetinle en büyük suçu işledin gözümde.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sorun var,sorunlar ve sorular ardından.",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        },
        {
          "chord": "A",
          "col": 35
        }
      ],
      "section": false,
      "t": null
    },
    {
