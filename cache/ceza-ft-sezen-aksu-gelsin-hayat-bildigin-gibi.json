{
  "slug": "ceza-ft-sezen-aksu-gelsin-hayat-bildigin-gibi",
  "artist": "Ceza Ft. Sezen Aksu",
  "title": "Gelsin Hayat Bildiğin Gibi",
  "key": "E",
  "capo": 0,
  "rhythm": null,
  "youtubeId": null,
  "hasSyncedLyrics": false,
  "lines": [
    {
      "lyric": "Birer birer kayıp giderde her bir sevilen,",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yenisi gelmez, eline geçmez hele ki değeri hiç bilinmeyen,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yürekte varsa sevgiden de ötesi, sen ağlasan da boş,",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Işıkta yaksan nafile, odan karanlık hep loş,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hayatın emri hep koş, bayağı bir bekledim boş,",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yaşantım sanki bir savaş ve hoşta bazen,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ateş kesildiğinde ve de sular durulduğunda,",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yoksa hep gülerdi insan, hep kalırdı masum,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Saygıda bir kusur ettiğinde minnetinde değeri yok,",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kafalarda hesaplar yapılır ve mesafeler konur,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Fakat bu kalp unutmaz, unutamaz ki zaten,",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Her kalp yıkılır ancak yenisi bulunamaz bir mesken,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Her anım birini özler,",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Rüyada yolunu gözlediğim, düşünceler ve benliğimle canlanır tüm hatıralarım,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bitince yalnızım,",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gözümü açtığımda kalmışım yanımda ailem ve bir de arkadaşlarım",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gelsin hayat bildiği gibi gelsin, işimiz bu yaşamak",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        },
        {
          "chord": "Am",
          "col": 38
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Unuttum bildiğimi doğarken, umudum ölmeden hatırlamak",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        },
        {
          "chord": "Am",
          "col": 46
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Şimdi boşuna bakma saate zaman geç oldu,",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Dün annem elimi tutarken bugün 29 da doldu,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Vakit can almaz ancak can yakar, fakat bir bekle bak,",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Knock out olursan çok sakat, mücadeleyle geçen hayatta son round,",
      "chords": [
        {
          "chord": "Em",
          "col": 100
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kazanmak herkes ister, ne istediğini bilmektir",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Önemlisi var mı listen, hayallerin, hırsın, cesaretin,",
      "chords": [
        {
          "chord": "Am",
          "col": 44
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sabır selametimse intikam felaketimdir,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ne mektebimde vardı huzurum, ne vardı evde,",
      "chords": [
        {
          "chord": "Em",
          "col": 17
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Çıkıp bir başıma ağlamaktı belki caddelerde,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hayallerin kurulduğu ve düşlerin yok olmadığı, bu gözlerinse dolduğu,",
      "chords": [
        {
          "chord": "Am",
          "col": 12
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Zamanın donduğu bir yerdeyim, düşünceler dumanlı dağlar aynı,",
      "chords": [
        {
          "chord": "Em",
          "col": 62
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gözse puslu, bir bakmışım mesafeler uzun ve tozlu,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Benimse yol yürür gider bir seyyah olurum,",
      "chords": [
        {
          "chord": "Am",
          "col": 15
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ne paranın bir değeri vardır aslında, ne de şerefle onurun",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gelsin hayat bildiği gibi gelsin, işimiz bu yaşamak",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        },
        {
          "chord": "Am",
          "col": 38
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Unuttum bildiğimi doğarken, umudum ölmeden hatırlamak",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        },
        {
          "chord": "Am",
          "col": 46
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ameleydim eskiden, şafak sökerdi her gün işe giderken",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Cebimde yoktu bir kuruş ve Üsküdar'ım'ın her bi' yeri yokuş",
      "chords": [
        {
          "chord": "Am",
          "col": 87
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Her gün yeni bi' suç",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "İttiler fakat ben olmadım tuş",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kanatlı doğmamış kuş",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Vakit hiç geçmemişti",
      "chords": [
        {
          "chord": "Em",
          "col": 15
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ben hep aynı yerde saydım",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ekmekle vardı kavgam, daha bi' sertti günler",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ve geçmişeydi saygım",
      "chords": [
        {
          "chord": "Am",
          "col": 26
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gelecekti kaygım, kelebekti kalbim",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Akar giderdim, olsa bile bi' derdim hep gülerdim",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ve ağladığımı görebilen bir annem bir de ben",
      "chords": [
        {
          "chord": "Em",
          "col": 5
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "İnceden bi' perde vardı gözlerimde",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Göz görür fakat dilim susardı",
      "chords": [
        {
          "chord": "Am",
          "col": 30
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ayaklarım, elim, kolum da bağlı",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hayat bu dile kolay velakin her bi' yerine ağrı",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ve kimi zaman düşündüm",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Aslında hiç üşenmedim ben, hep düşündüm",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hayata karşı dört silahşör hep güler sanmıştım",
      "chords": [
        {
          "chord": "Am",
          "col": 46
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bu öyle lanet olası toz bi' pembe ki",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bi' baktım her şey ciddi, hemen uyandım",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gelsin hayat bildiği gibi gelsin, işimiz bu yaşamak",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        },
        {
          "chord": "Am",
          "col": 38
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Unuttum bildiğimi doğarken, umudum ölmeden hatırlamak",
      "chords": [
        {
          "chord": "Em",
          "col": 0
        },
        {
          "chord": "Am",
