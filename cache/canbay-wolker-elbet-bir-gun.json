  "lines": [
    {
      "lyric": "Her şey söz verdiğim gibi",
      "chords": [
        {
          "chord": "Ab",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Canının yanmasını ister miyim",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Korkma yarim üzmem seni",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bari haber ver küs gelmeyim",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Saçına rüzgar değsin",
      "chords": [
        {
          "chord": "Ab",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Onuda kıskanırım ben bilmez misin",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Azıcık gülde güller açsın gözüm",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bi gençliğim var onuda ister misin?",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hevesim içten gelir",
      "chords": [
        {
          "chord": "Ab",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Dün ters kelepçe yedi bizden biri",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Orada gizlenmeyin",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Denk düşersek olanı da bizden bilin",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Dert etme o kadar kalmıycaz",
      "chords": [
        {
          "chord": "Ab",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bütün işler geçince anlayacaklar",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Rahat ol bizi kim susturucak",
      "chords": [
        {
          "chord": "Abm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kin besledik ama kan kusturucaz",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hiç kendine küfrettin mi ?",
      "chords": [
        {
          "chord": "Ab",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Etme o kadarı ürkekliktir",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gittiğin an bize külfet bindi",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Dostum mezarına güller diktim",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "İyi niyetimi çoktan kaybettim",
      "chords": [
        {
          "chord": "Ab",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kapındayım korkan namerttir",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Şimdilik elimde hiç bir şey yok",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ama yaradan yoktan var etmiş",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "[Nakarat]",
      "chords": [],
      "section": false,
      "t": null
    },
    {
