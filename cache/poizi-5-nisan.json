    },
    {
      "lyric": "Kayboluyor yıllarım bir kızın peşinde,",
      "chords": [
        {
          "chord": "B",
          "col": 21
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Denedim de yanılmadım bu işin sonunda.",
      "chords": [
        {
          "chord": "Db",
          "col": 26
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sonra da biri girer bence işin içine,",
      "chords": [
        {
          "chord": "Ebm",
          "col": 25
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "İçinden çıkamıyor, gelmiş yolun sonuna.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Çabaladım ben de yan yana duralım diye,",
      "chords": [
        {
          "chord": "B",
          "col": 28
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Duralım, bütün oyunları bozalım yine.",
      "chords": [
        {
          "chord": "Db",
          "col": 28
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bekliyorum sönmüş bir ateşin başında,",
      "chords": [
        {
          "chord": "Dbm",
          "col": 21
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Belki bir gün tekrar o da tutuşur diye.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bu kalbi neden, neden parçaladın?",
      "chords": [
        {
          "chord": "Ebm",
          "col": 53
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bana mı soruyorsun, ben akıllanmadım.",
      "chords": [
        {
          "chord": "B",
          "col": 63
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Seninle elbet bir yerde karşılaşırız,",
      "chords": [
        {
          "chord": "Db",
          "col": 16
        },
        {
          "chord": "Ebm",
          "col": 51
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sen unutmuşsundur, ben unutamadım.",
      "chords": [
        {
          "chord": "B",
          "col": 63
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ben gördüm bir resim,",
      "chords": [
        {
          "chord": "B",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Herkes mutluydu. Bak, yok vazgeçesim,",
      "chords": [
        {
          "chord": "Db",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Çok severdin, “Sevmem” demesin.",
      "chords": [
        {
          "chord": "Ebm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bir yola çıktım, Yok yoldan dönesim.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Geçtim senden bir kez,",
      "chords": [
        {
          "chord": "B",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yanıldım yine.",
      "chords": [
        {
          "chord": "Db",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Evime dönemedim,",
      "chords": [
        {
          "chord": "Ebm",
          "col": 26
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Unutmuş biri. Tamam da niye,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kendime gelemedim.",
      "chords": [
        {
          "chord": "B",
          "col": 30
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yanıldım her seferinde",
      "chords": [
        {
          "chord": "Db",
          "col": 27
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yanılmamış gibi, Sarıldım geçmişimle Unutmamış gibi.",
      "chords": [
        {
          "chord": "Ebm",
          "col": 23
        }
      ],
      "section": false,
