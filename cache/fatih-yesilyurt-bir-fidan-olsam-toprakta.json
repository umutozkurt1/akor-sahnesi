      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Çevrene ne yapacagım diye sorma vaktidir",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Alacağin cevabı ben söyleyim güzelim",
      "chords": [],
      "section": false,
      "t": null
