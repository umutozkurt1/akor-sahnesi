    {
      "lyric": "Güzel sözler kimi sevdi?",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Söyle moruk kim kimi sevdi?",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kim derdime sızdı ve beni gezdi?",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kim engine kızdı ve seni ezdi?",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kim yerlere düştü ve canı bezdi?",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kim aşığın oldu seni çizdi?..",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Her gün",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Dünyaya kızan rüyalar, gerçeğe alışan rüyalar",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "sustukça azan rüyalar…",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Her gün",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kursağıma sızan rüyalar,kavgayı bağıran rüyalar, sözlerimi",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "bozan rüyalar",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Arabesk bir şarkı eğilip kulağıma adını fısıldar ama yine",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "kısılmam.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Zaten sana yazdıran her halimle bana yazılman…",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Her gün",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hesabı keserim yarından, sökülür mü gözün bağrımdan, façalı",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "yürkleri çağarın lan!",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Öldüm",
      "chords": [],
      "section": false,
      "t": null
    },
    {
