      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "ve tüm aşklarımı toparlayıp kuraklığıma döndüm…",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hiç bakmadım ki etrafım hoş, etrafım loş ama etrafım boşmuş.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hiç kaçmadım ki efkarım dost, efkarım toz ama efkarım",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "suçmuş.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hiç korkmadım ki etraf kaos, aşkın lodos, zulmün dili yozmuş",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "diye.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hiç susmayınca efkarım bol, etrafım boş, hayalin dostmuş…",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Derdim bu değil, derdim sen.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Derdim yel, derdim bi umut tüm aşkımı acıyla özgürlüğüme",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "kenetleyen.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kimden gelirse gelsin yılmadım hiç ben küfürden.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sakladım hep zamanı gerçeğe sen gir diye penceremden.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Geceden bir yanım",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yani ışığına aşık, yani baya bi karışık, yani herşeye alışık…",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gecedense yarım",
      "chords": [],
      "section": false,
      "t": null
    },
    {
