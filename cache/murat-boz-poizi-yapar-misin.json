        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ben sende çok yaralandım, bir soru sadece, nasıl böyle iyi mi?",
      "chords": [
        {
          "chord": "G#m",
          "col": 0
        },
        {
          "chord": "F#",
          "col": 98
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sen kaç kere kaçtın, alıştım artık, nasıl böyle iyi mi?",
      "chords": [
        {
          "chord": "E",
          "col": 84
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Görmedin gözünle, durmadın sözünde",
      "chords": [
        {
          "chord": "F#",
          "col": 64
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ben yokum bu hikâyede, belki de böyle daha iyidir",
      "chords": [
        {
          "chord": "G#m",
          "col": 84
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Olmaz öyle, konuşarak yapamayız",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bugün belli, yarın değil, o yüzden ye o parayı",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Geç karşıma otur şöyle, neler olmuş, öyle değil mi?",
      "chords": [
        {
          "chord": "F#",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sana bi' kez hayatımı anlatayım",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Denedim hep dayanmayı",
      "chords": [
        {
          "chord": "E",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "\"Unutamıyorum\" desem olur bütün anılara büyük ayıp",
      "chords": [],
      "section": false,
      "t": null
    },
    {
