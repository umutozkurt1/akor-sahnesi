    },
    {
      "lyric": "Bahara söyle güneş toplasın,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sabaha kalmaz yanındayım",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Korkularımı anlatacağım ilk önce:",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Dizimin kanadığı ilk günü;",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sevmeye yeltendiğim ve sevilmediğimi anladığım ilk günü;",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Acının korkuları kuşattığı ölesiye savaştığı o ilk günü.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sonra diyeceğim: Acı korkuları yenmişti.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ruhumun kederden gözleri kararmış,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Körlüğüne birkaç cenaze bile vermişti.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Değişmişti çocukluğumun yazgısı.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sevmeyi bilmeyenlerin meyhanesinde çıraklık yapmıştı sadece",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bir parça ormanda yürür, denize çıplak gireriz sonra.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sonra içeriz bak!",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Karıştırmadan birkaç duble rakı veya şarap.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sen anlatırsın ha!",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Öyle özledim ki bana bir şeyler anlatmanı",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bana kurşunların ağırlığından bahseder,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Savaşın yaşanmış tüm acıları kustuğunu anlatırsın.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Acı yaşandıkça korkusuz sanar ya insan kendini,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "İşte o illüzyona nasıl küfrettiğini anlatırsın.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sonra bir Bukowski pervasızlığı sarar ruhunu,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "İki afilli cümle parlatırsın:",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "“Çamur yer, şekeri sevmem. Nerede lan benim viskim!” Der.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ardından bi’ şarkı patlatırsın.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Dağ yeşerir.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Dağı kar tutmuş o şehirden dön bu nasıl sevda?",
      "chords": [
        {
          "chord": "C",
          "col": 0
        },
        {
          "chord": "Em",
          "col": 61
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Acılar kusmuş o şehirden dön bu nasıl kavga?",
      "chords": [
        {
          "chord": "C",
          "col": 0
        },
        {
          "chord": "Em",
          "col": 58
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sonra seni ne kadar sevdiğime şaşırırsın belki.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Belki şımarırsın.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Belki şımardıkça azalırsın da belli olmaz benim sağım solum.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Şımarır mısın? Aşk şımartır mı seni?",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kimi şımartmamış ki!",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Şımar zaten beni ipleme, her haline şiirim ben.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bilmezsin sihirim sen, sinirim el, yokluğuna zifirim ben.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bilmezsin bir yel savurur senin kokuna.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "İşte o rüzgara mihirim ben.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bilmezsin ya işte o bilmediklerinin içindeki çukurum ben.",
      "chords": [],
      "section": false,
      "t": null
    },
    {
