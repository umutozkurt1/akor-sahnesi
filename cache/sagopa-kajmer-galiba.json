  "hasSyncedLyrics": false,
  "lines": [
    {
      "lyric": "Bu ikilemlerin arkasında çok şey var",
      "chords": [
        {
          "chord": "Dm",
          "col": 0
        },
        {
          "chord": "Am",
          "col": 4
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hiç bir şey bir neden değil ki",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ama hak ettiğimi düşündüğümde hiç de adil değilki",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sen nesin ve kimsin? Sal yaralı balıkları gitsin, misina artık çok gergin",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "İster istemez her şeyim sende rehin",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ne yanlış bir karar masası, sen ne kötü bir hakimsin",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bu ne zor bi dosya, sen ne kolay bir kararsın",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Senden görünmüyor önüm, meğer ne kolaymış fikri ölüm",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Hep anlatırdı sevdiklerim; böyleyken böyle olur.",
      "chords": [
        {
          "chord": "A#",
          "col": 0
        },
        {
          "chord": "Am",
          "col": 4
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Söz söylenir göz dolar, Haziranlar Şubat olur",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "İhtimallerimi düşünürüm ve ihmallerimi yoklarım,",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "İçimden ayrılık şarkıları bestelerim ve söylerim",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ben deli dolu biriyim, ama şu an sadece doluyum",
      "chords": [
        {
          "chord": "Dm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Kırılmış bir sağ kolum",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Gönlü bir hayli kırık, yapayalnız, bomboş bir yolum",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Beni arayan orda bulur, sözün bittiği yerde bekliyorum",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Canım malum, yarım eksik, bu kadar mı kolay çeker insan sevdiğinin şakaklarına tetik",
      "chords": [
        {
          "chord": "A#",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sanki sen bir avcı, bense infilak eden keklik",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Vakit durdu, bu acı beni boğdu, bittim şimdilik",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ama galiba, bütün bu olanlara dayanamam, ama hazırım",
      "chords": [
        {
          "chord": "Dm",
          "col": 0
        },
        {
          "chord": "Am",
          "col": 90
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sen giderken adımlarını sayarım",
      "chords": [
        {
          "chord": "A#",
          "col": 49
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Heyhat ! Ne yazık seni yanlış tanıdım sanırım",
      "chords": [
        {
          "chord": "Am",
          "col": 75
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "",
      "chords": [
        {
          "chord": "Dm",
          "col": 0
        },
        {
          "chord": "Am",
          "col": 4
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Üzerime yıkılan yüksek apartmanlar, bana söylenmiş gibi çalan şarkılar",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bitmeyen derin hasret ve geçmeyen zaman",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "En dibini ancak senin bildiğin o dipsiz kuyu, defol git şimdi rahat uyu",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ya biriktirdiğim onca yarınlık, ben yarımken yarınla bugün arasında nedir farklılık",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Senden varan güller artık rayihasız ben uslu çocuk sen arsız",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sensiz yerim yurdum yokmuş gibi ben diyarsız",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Herkes bana bakıyormuş gibi, ama her şey normal",
      "chords": [
        {
          "chord": "A#",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sorulan sorular en çok acı veren, her yerden sual",
      "chords": [],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ben bir aç, sense tok misal, sen olmadan ne işe yarar en güzel kumsal, ne olur gitme kal",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bir tek özlemleri deviremedim şu ince bileklerimle, geriye kalan herşeyi yıktım, fena yaptım",
      "chords": [
        {
          "chord": "Dm",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Ve en güzeli unuttum, defalarca tekrarladım kendimi, her yeni gün için ama her yeni gün eskidi",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Yarın baktım ki hep ordayım, aynı noktalardayım, ortada kalmış ortalık kişiyim",
      "chords": [
        {
          "chord": "A#",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Sen şimdi yoluna bak, ben adımlarını sayarım",
      "chords": [
        {
          "chord": "Am",
          "col": 0
        }
      ],
      "section": false,
      "t": null
    },
    {
      "lyric": "Bütün bu olanlara dayanamam, ama madem öyle hazırım",
      "chords": [],
      "section": false,
      "t": null
